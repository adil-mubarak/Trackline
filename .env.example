MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
GATEWAY_PORT=8082
CORS_ALLOWED_ORIGINS=
FRONTEND_PORT=3000
NATS_PORT=4222
JWT_SECRET=
# Used only between Gateway and Auth for MCP OAuth token introspection; generate a random 32+ character value.
MCP_OAUTH_INTERNAL_SECRET=
# Shared only by Gateway and the private MCP process to constrain OAuth username enrichment to MCP-originated calls.
MCP_USERNAME_LOOKUP_SECRET=
# For local runs use the Gateway origin; Render must set these to its public HTTPS origin and /mcp resource URL.
MCP_OAUTH_ISSUER_URL=http://localhost:8082
MCP_RESOURCE_URL=http://localhost:8082/mcp
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public URLs; register callback URLs ending in /api/auth/oauth/{github|google}/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:8082
OAUTH_FRONTEND_URL=http://localhost:5173/
STITCH_API_KEY=
OPENROUTER_API_KEY=
# AI MCP endpoint: Compose overrides this with http://mcp:8088/mcp; loopback is for colocated Render or local process mode.
MCP_INTERNAL_URL=http://127.0.0.1:8088/mcp
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# GitHub App private key PEM (literal \n sequences are accepted).
GITHUB_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com
# Explicitly opt in only after approving GitHub evidence processing by OpenRouter.
GITHUB_EVIDENCE_TO_OPENROUTER=false
# Source diffs from explicitly linked PRs are separately gated; approve provider processing first.
GITHUB_CODE_TO_OPENROUTER=false
